<% layout("/layouts/boilerplate") %>


<div class="row mt-3">
    <div class="col-8 ">

        <h3>
            <%= listing.title %>
        </h3>
    </div>
<br><br>
        <div class="card col-6 offset-2 show-card listing-card">
            <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">
            <div class="card-body">
                <p class="card-text">
                    <br>
                    <br>&nbsp;
                    <i>"<%= listing.description %>"</i>
                     <br>
                    <%= listing.location %>
                    , <%= listing.country %>
                    <br>&nbsp;<br>
                     ₹<%= listing.price.toLocaleString("en-IN") %>
                </p>
            </div>
        </div>

        <br>

        <div class="btns">
            <form action="/listings/<%=listing._id%>/edit" method="get">
                <button class="btn btn-dark edit-btn">
                    Edit
                </button>
            </form>
&nbsp;&nbsp;&nbsp;&nbsp;
            <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
                <button class="btn btn-dark ">
                    Delete
                </button>
            </form>
        </div>



        <!--! Review side -->



        <div class="col-8 offset-3 mb-3">
            <hr><br>
            <h4>Leave a Review</h4>

            <form method="POST" action="/listings/<%=listing.id%>/reviews" novalidate class="needs-validation">

                <div class="mb-3 mt-3">
                    <label for="rating" class="form-label"> Rating :  </label>
                    &nbsp;&nbsp;
                    <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
                </div>
                <div class="mb-3 mt-3"> 
                    <label for="comment" class="form-label"> Comment : </label>
                    <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>

                    <div class="invalid-feedback">
                        Add some comment first
                    </div>

                    <br>
                    <button class="btn btn-outline-dark">Submit</button>
                    </form>
                

                <hr>

                <p>
                    <b>All Reviews : </b> 
                </p>

                <div class="row">
                <% for(review of listing.reviews){ %>
                        <div class="card col-5 ms-3 mb-3">
                            <div class="card-body">
                                <h5 class="card-tile">
                                    Ishowspeed
                                </h5>
                                <p class="card-text">
                                    <%= review.comment %>
                                </p>
                                <p class="card-text">
                                    <%= review.rating %> stars
                                </p>
                            </div>

                            <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mb-3">

                                <button class="btn btn-sm btn-dark mt-2">Delete</button>

                            </form>
                        </div>
                <% } %>
            </div>
        </div>
        
</div>