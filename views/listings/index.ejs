<form>
    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault"><i>Default Total after Taxes</i></label>
        </div>
    </div>
</form>




<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-4">
    <% for(let listing of allListings){ %>
        <a href="/listings/<%= listing._id %>" class="listing-link">
            <div class="card col listing-card">
                <img src="<%= listing.image.url %>" class="card-img" alt="listing image" style="height: 20rem;">

                <div class="card-img-overlay"></div>

                <div class="card-body">
                    <p class="card-text">
                        <b>
                            <i><%= listing.title %></i>
                        </b>
                        <br>
                        <p><i><%= listing.description %></i></p>
                        <br>
                        <p class="listing-price" data-price="<%= listing.price %>">
                            ₹<i><%= listing.price.toLocaleString("en-IN") %></i> /night
                            <i class="tax-info">(18% GST added)</i>
                        </p>
                    </p>
                </div>
            </div>
        </a>
    <% } %>
</div>


<script>
    let taxSwitch = document.getElementById("switchCheckDefault");
    let prices = document.getElementsByClassName("listing-price");
    let taxInfo = document.getElementsByClassName("tax-info");

    taxSwitch.addEventListener("change" , ()=>{
        for(price of prices){
            let orgPrice = Number(price.dataset.price);
            let priceElement = price.querySelector("i");

            if(taxSwitch.checked){
                priceElement.innerText = (orgPrice * 1.18).toLocaleString("en-IN");
            }else{
                priceElement.innerText = orgPrice.toLocaleString("en-IN");
            }
        }

        for(info of taxInfo){
            info.style.display = taxSwitch.checked ? "inline" : "none";
        }
    });
</script>