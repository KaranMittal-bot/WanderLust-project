<style>
    #filters{
        display: flex;
        align-items: center;
        gap: 2rem;
        overflow-x: auto;
        flex-wrap: nowrap;
        padding: 1rem 2rem;
    }
    .filter{
        flex: 0 0 auto;
        text-align: center;
        margin: 0;
        text-decoration: none;
        color: #717171;
    }
    .filter:hover{
        opacity: 1;
        transition: 0.2s;
        color: #222;
    }

    .filter svg {
    width: 2rem;
    height: 2rem;
    object-fit: contain;
    display: block;
    margin: 0 auto 0.3rem;
}

    .tax-info{
